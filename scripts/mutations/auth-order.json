{
 "command": "npx vitest run apps/api/src/auth apps/api/src/route-coverage",
 "mutations": [
  {
   "name": "auth runs at preHandler (after body parsing)",
   "file": "apps/api/src/auth.ts",
   "old": "app.addHook(\"onRequest\", async (request, reply) => {\n    if (isPublicRequest",
   "new": "app.addHook(\"preHandler\", async (request, reply) => {\n    if (isPublicRequest"
  },
  {
   "name": "auth only guards /v1/ prefix (not default-deny)",
   "file": "apps/api/src/auth.ts",
   "old": "if (isPublicRequest(request.method, request.url)) return;",
   "new": "if (!request.url.startsWith(\"/v1/\")) return;"
  },
  {
   "name": "non-GET/HEAD methods allowed on public paths",
   "file": "apps/api/src/auth.ts",
   "old": "if (method !== \"GET\" && method !== \"HEAD\") return false;",
   "new": ""
  },
  {
   "name": "public asset pattern widened to any /hub/ path",
