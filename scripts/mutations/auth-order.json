   "file": "apps/api/src/auth.ts",
   "old": "  return q === -1 ? rawUrl : rawUrl.slice(0, q);",
   "new": "  return rawUrl;"
  },
  {
   "name": "health prefix public (/health/*)",
   "file": "apps/api/src/auth.ts",
   "old": "PUBLIC_EXACT.has(path) ||",
   "new": "PUBLIC_EXACT.has(path) || path.startsWith(\"/health\") ||"
  },
  {
   "name": "unconfigured token runs open",
   "file": "apps/api/src/auth.ts",
   "old": "if (!configuredToken) return reply.code(503)",
   "new": "if (!configuredToken) return; if (false) return reply.code(503)"
  }
 ]
}