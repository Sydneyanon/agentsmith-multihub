{
  "name": "agentsmith-multihub",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-driven security research and bug-bounty operations platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc -p apps/web/tsconfig.json && node scripts/copy-web.mjs",
    "start": "node dist/apps/api/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.test.json",
    "test": "vitest run --exclude '**/*.integration.test.ts' --exclude '.claude/**'",
    "test:integration": "node scripts/test-integration.mjs",
    "test:integration:restricted": "TEST_RUNTIME_ROLE=1 node scripts/test-integration.mjs",
    "db:migrate": "node dist/scripts/migrate.js",
    "db:grants": "node dist/scripts/apply-runtime-grants.js",
    "worker:intake": "node dist/apps/api/src/worker-main.js",
    "worker:intake:dev": "tsx apps/api/src/worker-main.ts",
    "worker:token": "node dist/apps/api/src/worker-token-main.js",
    "bounties:collect": "node dist/apps/api/src/bounties/collect-main.js",
    "bounties:collect:dev": "tsx apps/api/src/bounties/collect-main.ts",
    "staging:configs": "tsx scripts/staging-config.ts",
    "verify": "node scripts/verify.mjs",
    "hub:screenshots": "tsx scripts/hub-screenshots.ts",
    "hub:layout-check": "tsx scripts/hub-layout-check.ts",
    "loop": "tsx scripts/research-loop.ts",
    "bounties:immunefi-reconcile": "tsx scripts/immunefi-reconcile.ts",
    "bounties:promote": "node dist/apps/api/src/bounties/promote-main.js",
    "bounties:promote:dev": "tsx apps/api/src/bounties/promote-main.ts",
    "bounties:monitor": "node dist/apps/api/src/bounties/monitor-main.js",
    "bounties:monitor:dev": "tsx apps/api/src/bounties/monitor-main.ts",
    "bounties:enrich": "node dist/apps/api/src/bounties/enrich-main.js",
    "bounties:enrich:dev": "tsx apps/api/src/bounties/enrich-main.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "type": "module"
}
