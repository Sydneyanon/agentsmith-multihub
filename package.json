{
  "name": "agentsmith-multihub",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-driven security research and bug-bounty operations platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "node scripts/test-integration.mjs",
    "db:migrate": "node dist/scripts/migrate.js",
    "worker:intake": "node dist/apps/api/src/worker-main.js",
    "worker:intake:dev": "tsx apps/api/src/worker-main.ts",
    "staging:configs": "tsx scripts/staging-config.ts",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "type": "module"
}
