NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=
# Required for all /v1/* API routes; use a randomly generated secret of at least 32 characters
API_BEARER_TOKEN=
# Set true to block all new AI API calls (global kill switch)
AI_BUDGET_EMERGENCY_STOP=false
# Database client (see docs/runtime-and-verification.md). A database that auto-pauses needs 30000.
DATABASE_CONNECT_TIMEOUT_MS=3000
# TLS is on in production and for non-loopback hosts; only set false if the server certificate cannot be verified.
DATABASE_SSL_VERIFY=true
