+
+/** the net change one call makes to every state quantity, and the quantities whose change cannot be stated exactly */
+export function functionChange(ix: ProgramIndex, contract: string, fn: FunctionDef, tr: TraceResult): FunctionChange & { kinds: Map<string, "ledger" | "aggregate" | "other"> } {
