diff --git a/apps/api/src/analysis/solidity/challenge.ts b/apps/api/src/analysis/solidity/challenge.ts
index 8c78091..9f736c5 100644
--- a/apps/api/src/analysis/solidity/challenge.ts
+++ b/apps/api/src/analysis/solidity/challenge.ts
@@ -100,12 +100,51 @@ export function challengeUncheckedCall(ix: ProgramIndex, f: Finding, entry: Func
   } catch (e) { if (e instanceof Unsupported) return { verdict: "inconclusive", method, reason: `not modelled: ${e.why}`, trace: [], scenarios: 0 }; throw e; }
 }
 
+/**
+ * protocol-invariant: execute the breaking function in a modelled world where the aggregate equals the sum of the ledger, and compare the
+ * change of the aggregate with the change of the ledger's sum. The functions the invariant was inferred from are executed first, each in a
+ * fresh world, and must keep the two equal in the model: if they do not, the inference itself is not supported and the method abstains.
+ */
+export function challengeInvariant(ix: ProgramIndex, f: Finding, entry: FunctionDef): ChallengeOutcome {
+  const method = "execution: change of the aggregate versus change of the sum of the ledger in one call";
+  const agg = String(f.detail["aggregate"] ?? ""); const ledger = String(f.detail["ledger"] ?? "");
+  if (!agg || !ledger || ledger.includes(".")) return { verdict: "inconclusive", method, reason: "the ledger is a struct field, which the execution model does not represent", trace: [], scenarios: 0 };
+  const sumL = (it: Interp) => { let s = 0n; for (const [k, v] of it.w.storage) if (k.startsWith(`${ledger}|`) && k.split("|").length === 2 && typeof v === "bigint") s += v; return s; };
+  const world = (fn: FunctionDef) => { const it = freshInterp(ix, entry.contract, fn); it.writeVar(agg, [], sumL(it)); it.w.trace = []; return it; };
+  const run = (fn: FunctionDef): { ok: boolean; why: string; dA: bigint; dL: bigint; who: string } => {
+    let last = { ok: false, why: "", dA: 0n, dL: 0n, who: "" };
+    for (const who of ["attacker", "owner0"]) for (const args of argVariants(fn)) {
+      const it = world(fn); const a0 = it.num(it.readVar(agg, []), agg); const l0 = sumL(it);
+      const r = attempt(it, fn, who, fn.mutability === "payable" ? ETHER : 0n, args);
+      if (!r.ok) { last = { ...last, why: r.why }; continue; }
+      const out = { ok: true, why: "", dA: it.num(it.readVar(agg, []), agg) - a0, dL: sumL(it) - l0, who };
+      if (out.dA !== 0n || out.dL !== 0n) return out; last = out;
+    }
+    return last;
+  };
+  try {
+    const maintainers = String(f.detail["maintainers"] ?? "").split(",").filter((n) => n && n !== "constructor");
+    let scenarios = 0; const checked: string[] = [];
+    for (const name of maintainers) {
+      const m = ix.findFunctions(entry.contract, name)[0]; if (!m) continue;
+      const r = run(m); scenarios++;
+      if (r.ok && r.dA !== r.dL) return { verdict: "inconclusive", method, reason: `${name}, one of the functions the invariant was inferred from, does not keep it in the model (${agg} ${r.dA}, sum ${r.dL}); the inference is not supported by execution`, trace: [], scenarios };
+      if (r.ok && r.dA !== 0n) checked.push(`${name} (as ${r.who}) changes ${agg} and the sum of ${ledger} by ${r.dA}`);
+    }
+    const r = run(entry); scenarios++;
+    if (!r.ok) return { verdict: "inconclusive", method, reason: `${entry.name} reverts in the model for every caller and argument tried (${r.why})`, trace: checked, scenarios };
+    if (r.dA !== r.dL) return { verdict: "validated", method, reason: `${entry.name}, called by ${r.who === "attacker" ? "an unprivileged caller" : "the privileged deployer"}, changes ${agg} by ${r.dA} but the sum of ${ledger} by ${r.dL}: afterwards ${agg} != sum(${ledger})`, trace: [`world: ${agg} seeded equal to the sum of ${ledger}`, ...checked, `${entry.name} completes: ${agg} ${r.dA >= 0n ? "+" : ""}${r.dA}, sum(${ledger}) ${r.dL >= 0n ? "+" : ""}${r.dL}`], scenarios };
+    return { verdict: "refuted", method, reason: `${entry.name} completes and changes ${agg} and the sum of ${ledger} by the same amount (${r.dA}) in the model`, trace: checked, scenarios };
+  } catch (e) { if (e instanceof Unsupported) return { verdict: "inconclusive", method, reason: `not modelled: ${e.why}`, trace: [], scenarios: 0 }; throw e; }
+}
+
 export function challengeFinding(ix: ProgramIndex, f: Finding): ChallengeOutcome | null {
   const entry = ix.findFunctions(f.contract, f.function)[0]; if (!entry) return { verdict: "inconclusive", method: "none", reason: "function not found", trace: [], scenarios: 0 };
   switch (f.class) {
     case "access-control": case "selfdestruct": case "delegatecall": return challengeReachability(ix, f, entry);
     case "initializer": return challengeInitializer(ix, f, entry);
     case "unchecked-call": return challengeUncheckedCall(ix, f, entry);
+    case "protocol-invariant": return challengeInvariant(ix, f, entry);
     default: return null; // reentrancy has its own validator; tx-origin has no independent method yet
   }
 }
diff --git a/apps/api/src/analysis/solidity/invariants.test.ts b/apps/api/src/analysis/solidity/invariants.test.ts
new file mode 100644
index 0000000..3582536
--- /dev/null
+++ b/apps/api/src/analysis/solidity/invariants.test.ts
@@ -0,0 +1,349 @@
+import { describe, expect, it } from "vitest";
+import { analyzeSources } from "./specialists.js";
+import { ProgramIndex } from "./index.js";
+import { challengeFinding } from "./challenge.js";
+
+/**
+ * protocol-invariant: a conservation relation between an aggregate and a per-account ledger (totalSupply == sum of balances) is inferred
+ * from the functions that keep it, and a function that changes the two sides by different amounts is reported. All contracts here are
+ * synthetic and written for this test.
+ */
+const analyse = (text: string, path = "s/T.sol") => {
+  const lines = text.split("\n");
+  const lineOf = (needle: string) => { const i = lines.findIndex((l) => l.includes(needle)); if (i < 0) throw new Error(`no line with ${needle}`); return i + 1; };
+  const { findings, index } = analyzeSources([{ path, text }]);
+  const inv = findings.filter((f) => f.class === "protocol-invariant");
+  return { findings, inv, lineOf, index, of: (fn: string) => inv.filter((f) => f.function === fn) };
+};
+
+const token = (extra: string, opts: { header?: string } = {}) => `pragma solidity ^0.8.20;
+contract Token {
+    mapping(address => uint256) public balanceOf;
+    uint256 public totalSupply;
+    address public owner;
+${opts.header ?? ""}
+    constructor() { owner = msg.sender; }
+    function mint(address to, uint256 amount) external {
+        require(msg.sender == owner, "owner");
+        balanceOf[to] += amount;
+        totalSupply += amount;
+    }
+    function burn(uint256 amount) external {
+        balanceOf[msg.sender] -= amount;
+        totalSupply -= amount;
+    }
+    function transfer(address to, uint256 amount) external returns (bool) {
+        balanceOf[msg.sender] -= amount;
+        balanceOf[to] += amount;
+        return true;
+    }
+${extra}
+}`;
+
+describe("protocol-invariant: positives", () => {
+  it("flags a burn path that lowers balances but not totalSupply, citing the maintainers as evidence", () => {
+    const { of, inv, lineOf } = analyse(token(`
+    function burnFrom(address from, uint256 amount) external {
+        require(msg.sender == owner, "owner");
+        balanceOf[from] -= amount;
+    }`));
+    expect(inv).toHaveLength(1);
+    const f = of("burnFrom")[0]!;
+    expect(f.line).toBe(lineOf("balanceOf[from] -= amount;"));
+    expect(f.detail).toMatchObject({ aggregate: "totalSupply", ledger: "balanceOf", maintainers: "mint,burn", aggregateDelta: "0", ledgerDelta: "-amount" });
+    expect(f.claim).toContain("totalSupply == sum over accounts a of balanceOf[a]");
+    expect(f.claim).toMatch(/mint changes both by \+amount \(s\/T\.sol:\d+, s\/T\.sol:\d+\)/);
+    expect(f.claim).toContain("burn changes both by -amount");
+    expect(f.claim).toContain("transfer move value between accounts");
+    expect(f.requiredChecks.length).toBeGreaterThan(0);
+    expect(f.alternatives.length).toBeGreaterThan(0);
+    expect(f.spans[0]).toMatchObject({ file: "s/T.sol", lineStart: f.line, role: "primary" });
+  });
+
+  it("flags a mint that credits a different amount from the one added to the supply", () => {
+    const { of, inv, lineOf } = analyse(token(`
+    function mintWithBonus(address to, uint256 amount, uint256 bonus) external {
+        require(msg.sender == owner, "owner");
+        totalSupply += amount;
+        balanceOf[to] += amount + bonus;
+    }`));
+    expect(inv.map((f) => f.function)).toEqual(["mintWithBonus"]);
+    expect(of("mintWithBonus")[0]!.detail).toMatchObject({ aggregateDelta: "+amount", ledgerDelta: "+amount + bonus" });
+    expect(of("mintWithBonus")[0]!.line).toBe(lineOf("balanceOf[to] += amount + bonus;"));
+  });
+
+  it("follows internal helpers: maintainers and the breaker all go through _mint / _burn style helpers", () => {
+    const { of, inv, lineOf } = analyse(`pragma solidity ^0.8.20;
+contract Shares {
+    mapping(address => uint256) internal shares;
+    uint256 internal totalShares;
+    function _credit(address who, uint256 n) internal { shares[who] += n; totalShares += n; }
+    function _debit(address who, uint256 n) internal { shares[who] -= n; totalShares -= n; }
+    function _debitOnly(address who, uint256 n) internal { shares[who] = shares[who] - n; }
+    function join(uint256 n) external { _credit(msg.sender, n); }
+    function leave(uint256 n) external { _debit(msg.sender, n); }
+    function forfeit(address who, uint256 n) external { _debitOnly(who, n); }
+}`);
+    expect(inv.map((f) => f.function)).toEqual(["forfeit"]);
+    const f = of("forfeit")[0]!;
+    expect(f.line).toBe(lineOf("function _debitOnly"));
+    expect(f.chain.map((c) => c.fn)).toEqual(["_debitOnly"]);
+    expect(f.detail).toMatchObject({ ledgerDelta: "-n", maintainers: "join,leave" });
+    expect(f.spans.some((s) => s.role === "supporting" && s.lineStart === lineOf("function forfeit"))).toBe(true); // the call site in the caller
+  });
+
+  it("flags an emergency withdrawal that zeroes a deposit read into a local but forgets the total", () => {
+    const { of, inv, lineOf } = analyse(`pragma solidity ^0.8.20;
+contract Pool {
+    mapping(address => uint256) public deposits;
+    uint256 public totalDeposits;
+    function deposit() external payable { deposits[msg.sender] += msg.value; totalDeposits += msg.value; }
+    function withdraw() external {
+        uint256 amt = deposits[msg.sender];
+        deposits[msg.sender] = 0;
+        totalDeposits -= amt;
+        payable(msg.sender).transfer(amt);
+    }
+    function emergencyWithdraw() external {
+        uint256 amt = deposits[msg.sender];
+        delete deposits[msg.sender];
+        payable(msg.sender).transfer(amt);
+    }
+}`);
+    expect(inv.map((f) => f.function)).toEqual(["emergencyWithdraw"]);
+    expect(of("emergencyWithdraw")[0]!.line).toBe(lineOf("delete deposits[msg.sender];"));
+    expect(of("emergencyWithdraw")[0]!.confidence).toBe("medium"); // an absolute write to the ledger
+    expect(of("emergencyWithdraw")[0]!.detail).toMatchObject({ ledgerDelta: "-deposits[msg.sender]", aggregateDelta: "0" });
+  });
+
+  it("resolves branches on helper arguments and on earlier reverting checks (a single _update(from, to, v) helper)", () => {
+    const { inv, of, lineOf } = analyse(`pragma solidity ^0.8.20;
+contract Unified {
+    mapping(address => uint256) private _balances;
+    uint256 private _totalSupply;
+    error Bad();
+    function _update(address from, address to, uint256 value) internal {
+        if (from == address(0)) {
+            _totalSupply += value;
+        } else {
+            uint256 fromBalance = _balances[from];
+            if (fromBalance < value) revert Bad();
+            unchecked { _balances[from] = fromBalance - value; }
+        }
+        if (to == address(0)) {
+            unchecked { _totalSupply -= value; }
+        } else {
+            unchecked { _balances[to] += value; }
+        }
+    }
+    function mint(address account, uint256 value) external {
+        if (account == address(0)) revert Bad();
+        _update(address(0), account, value);
+    }
+    function burn(uint256 value) external { _update(msg.sender, address(0), value); }
+    function transfer(address to, uint256 value) external {
+        if (to == address(0)) revert Bad();
+        _update(msg.sender, to, value);
+    }
+    function slash(address account, uint256 value) external {
+        unchecked { _balances[account] -= value; }
+    }
+}`);
+    expect(inv.map((f) => f.function)).toEqual(["slash"]);
+    expect(of("slash")[0]!.line).toBe(lineOf("unchecked { _balances[account] -= value; }"));
+    expect(of("slash")[0]!.detail).toMatchObject({ maintainers: "mint,burn" });
+  });
+
+  it("handles ledgers that are a struct field reached through a storage reference", () => {
+    const { inv, of } = analyse(`pragma solidity ^0.8.20;
+contract Staking {
+    struct Account { uint256 staked; uint256 since; }
+    mapping(address => Account) internal accounts;
+    uint256 public totalStaked;
+    function stake(uint256 a) external { Account storage acc = accounts[msg.sender]; acc.staked += a; acc.since = block.timestamp; totalStaked += a; }
+    function unstake(uint256 a) external { Account storage acc = accounts[msg.sender]; acc.staked -= a; totalStaked -= a; }
+    function compound(uint256 reward) external { accounts[msg.sender].staked += reward; }
+}`);
+    expect(inv.map((f) => f.function)).toEqual(["compound"]);
+    expect(of("compound")[0]!.detail).toMatchObject({ ledger: "accounts.staked", aggregate: "totalStaked" });
+    expect(of("compound")[0]!.claim).toContain("totalStaked == sum over accounts a of accounts[a].staked");
+  });
+
+  it("handles SafeMath-style .add/.sub and x = x + y forms", () => {
+    const { inv } = analyse(`pragma solidity ^0.6.12;
+library SafeMath {
+    function add(uint256 a, uint256 b) internal pure returns (uint256) { uint256 c = a + b; require(c >= a); return c; }
+    function sub(uint256 a, uint256 b) internal pure returns (uint256) { require(b <= a); return a - b; }
+}
+contract Old {
+    using SafeMath for uint256;
+    mapping(address => uint256) balances;
+    uint256 supply;
+    function mint(uint256 v) external { balances[msg.sender] = balances[msg.sender].add(v); supply = supply.add(v); }
+    function burn(uint256 v) external { balances[msg.sender] = balances[msg.sender] - v; supply = supply - v; }
+    function badBurn(uint256 v) external { balances[msg.sender] = balances[msg.sender].sub(v); supply = supply.sub(v / 2); }
+}`);
+    expect(inv.map((f) => f.function)).toEqual(["badBurn"]);
+  });
+});
+
+describe("protocol-invariant: values are tracked, not names", () => {
+  it("a local reassigned on a branch becomes a fresh unknown (no false balance from a stale name), so the mismatch is reported", () => {
+    const { inv } = analyse(token(`
+    bool public halve;
+    function burnOdd(uint256 v) external { uint256 x = v; if (halve) { x = v / 2; } balanceOf[msg.sender] -= v; totalSupply -= x; }`));
+    expect(inv.map((f) => f.function)).toEqual(["burnOdd"]);
+  });
+});
+
+describe("protocol-invariant: negatives (no lead)", () => {
+  it("a correct token: mint, burn, transfer, transferFrom with allowances", () => {
+    const { inv } = analyse(token(`
+    mapping(address => mapping(address => uint256)) public allowance;
+    function approve(address s, uint256 v) external { allowance[msg.sender][s] = v; }
+    function transferFrom(address from, address to, uint256 v) external {
+        allowance[from][msg.sender] -= v;
+        balanceOf[from] -= v;
+        balanceOf[to] += v;
+    }`));
+    expect(inv).toHaveLength(0);
+  });
+
+  it("only one maintaining function is not enough evidence to infer the invariant", () => {
+    const { inv } = analyse(`pragma solidity ^0.8.20;
+contract One {
+    mapping(address => uint256) public balanceOf;
+    uint256 public totalSupply;
+    function mint(uint256 v) external { balanceOf[msg.sender] += v; totalSupply += v; }
+    function burn(uint256 v) external { balanceOf[msg.sender] -= v; }
+}`);
+    expect(inv).toHaveLength(0);
+  });
+
+  it("value moved into another bucket in the same call is not a break (staking out of balances)", () => {
+    const { inv } = analyse(token(`
+    mapping(address => uint256) public staked;
+    uint256 public reserve;
+    function stake(uint256 v) external { balanceOf[msg.sender] -= v; staked[msg.sender] += v; }
+    function unstake(uint256 v) external { staked[msg.sender] -= v; balanceOf[msg.sender] += v; }
+    function takeFee(uint256 v) external { balanceOf[msg.sender] -= v; reserve += v; }`));
+    expect(inv).toHaveLength(0);
+  });
+
+  it("a write under a condition that is not decided statically, or inside a loop, is skipped, not reported", () => {
+    const { inv } = analyse(token(`
+    bool public burnsReduceSupply;
+    function burnMaybe(uint256 v) external { balanceOf[msg.sender] -= v; if (burnsReduceSupply) totalSupply -= v; }
+    function airdrop(address[] calldata to, uint256 v) external { for (uint256 i = 0; i < to.length; i++) { balanceOf[to[i]] += v; } }`));
+    expect(inv).toHaveLength(0);
+  });
+
+  it("a fee split that pays the fee to another account is balanced (linear arithmetic over the amounts)", () => {
+    const { inv } = analyse(token(`
+    address public feeTo;
+    function transferWithFee(address to, uint256 v) external {
+        uint256 fee = v / 100;
+        balanceOf[msg.sender] -= v;
+        balanceOf[to] += v - fee;
+        balanceOf[feeTo] += fee;
+    }
+    function burnAll() external {
+        uint256 b = balanceOf[msg.sender];
+        delete balanceOf[msg.sender];
+        totalSupply -= b;
+    }`));
+    expect(inv).toHaveLength(0);
+  });
+
+  it("shares and assets that differ by design are never paired (no function keeps them equal)", () => {
+    const { inv } = analyse(`pragma solidity ^0.8.20;
+contract Vault {
+    mapping(address => uint256) public shares;
+    uint256 public totalAssets;
+    uint256 public totalShares;
+    function deposit(uint256 assets) external { uint256 s = totalShares == 0 ? assets : assets * totalShares / totalAssets; shares[msg.sender] += s; totalShares += s; totalAssets += assets; }
+    function redeem(uint256 s) external { uint256 assets = s * totalAssets / totalShares; shares[msg.sender] -= s; totalShares -= s; totalAssets -= assets; }
+}`);
+    expect(inv).toHaveLength(0);
+  });
+
+  it("an absolute re-set of the aggregate (a resynchronisation) is not reported", () => {
+    const { inv } = analyse(token(`
+    function sync(uint256 v) external { require(msg.sender == owner); totalSupply = v; }`));
+    expect(inv).toHaveLength(0);
+  });
+
+  it("an unchecked block around a correct burn changes nothing", () => {
+    const { inv } = analyse(token(`
+    function burnUnchecked(uint256 v) external { require(balanceOf[msg.sender] >= v); unchecked { balanceOf[msg.sender] -= v; totalSupply -= v; } }`));
+    expect(inv).toHaveLength(0);
+  });
+
+  it("a helper parameter reassigned before use is tracked by value, not by name", () => {
+    const { inv } = analyse(token(`
+    function _take(address who, uint256 v) internal { uint256 half = v / 2; balanceOf[who] -= half; v = half; totalSupply -= v; }
+    function burnHalf(uint256 v) external { _take(msg.sender, v); }`));
+    expect(inv).toHaveLength(0);
+  });
+
+  it("a total that only ever grows with the ledger (a cumulative counter) does not establish the relation", () => {
+    const { inv } = analyse(`pragma solidity ^0.8.20;
+contract Counter {
+    mapping(address => uint256) public deposits;
+    uint256 public totalDepositedEver;
+    function deposit() external payable { deposits[msg.sender] += msg.value; totalDepositedEver += msg.value; }
+    function depositFor(address who) external payable { deposits[who] += msg.value; totalDepositedEver += msg.value; }
+    function withdraw(uint256 v) external { deposits[msg.sender] -= v; payable(msg.sender).transfer(v); }
+}`);
+    expect(inv).toHaveLength(0);
+  });
+
+  it("a burn that keeps totalSupply right is not reported against a second, minted-ever total", () => {
+    const { inv } = analyse(token(`
+    uint256 public totalMinted;
+    function mintTracked(address to, uint256 v) external { require(msg.sender == owner); balanceOf[to] += v; totalSupply += v; totalMinted += v; }
+    function mintTracked2(address to, uint256 v) external { require(msg.sender == owner); balanceOf[to] += v; totalSupply += v; totalMinted += v; }
+    function burnTracked(uint256 v) external { balanceOf[msg.sender] -= v; totalSupply -= v; }`));
+    expect(inv).toHaveLength(0);
+  });
+
+  it("a constructor that mints the initial supply is evidence, never a breaker", () => {
+    const { inv } = analyse(`pragma solidity ^0.8.20;
+contract Fixed {
+    mapping(address => uint256) public balanceOf;
+    uint256 public totalSupply;
+    constructor(uint256 initial) { totalSupply = initial; balanceOf[msg.sender] = initial / 2; }
+    function burn(uint256 v) external { balanceOf[msg.sender] -= v; totalSupply -= v; }
+    function mint(uint256 v) external { balanceOf[msg.sender] += v; totalSupply += v; }
+}`);
+    expect(inv).toHaveLength(0);
+  });
+});
+
+describe("protocol-invariant: execution challenge", () => {
+  it("validates a real break by execution and refutes nothing it cannot run", () => {
+    const text = token(`
+    function burnFrom(address from, uint256 amount) external {
+        require(msg.sender == owner, "owner");
+        balanceOf[from] -= amount;
+    }`);
+    const { inv } = analyse(text);
+    const c = challengeFinding(new ProgramIndex([{ path: "s/T.sol", text }]), inv[0]!)!;
+    expect(c.verdict).toBe("validated");
