+import type { ProgramIndex } from "./index.js";
+import type { FunctionDef } from "./parser.js";
+import { addLin, recordToLin, scale, type Ev, type Lin, type TraceResult } from "./trace.js";
+
+/**
+ * Conservation invariants between an AGGREGATE and a LEDGER (totalSupply == sum of balances[a]; totalDeposits == sum of deposits[a]).
+ *
+ * Nothing is assumed from names. For every state-changing function of a deployed contract (and its constructors) the trace gives each
+ * write as a linear change over symbolic amounts, already resolved through internal helpers, storage references and locals (trace.ts
+ * `delta`). Summing the changes per function gives, for every scalar unsigned state variable A and every address-keyed numeric ledger L,
+ * the net change of A and the net change of sum(L) that one call makes (keys do not matter: a transfer moving `v` from one key to another
+ * nets to zero).
+ *
+ * The relation "A == sum(L)" is INFERRED for a pair only when at least two functions change both sides by the same non-zero amount
+ * (they MAINTAIN it: mint and burn, deposit and withdraw), and those functions include at least one that increases both and one that decreases
+ * both (a total that only grows may be a cumulative counter). A function that changes one side by a different amount from the other BREAKS it,
+ * unless another state quantity changes by exactly the missing amount in the same call (value moved to another bucket: staking from
+ * `balances` into `staked`, fees into a reserve), or the same call keeps another aggregate equal to the ledger's change, or A is re-set
+ * absolutely (a resynchronisation). A pair is reported only when the
+ * maintaining functions outnumber the breaking ones. Functions whose change cannot be stated exactly (a write inside a loop, under a
+ * condition that is not decided statically, a non-linear update, an unanalysed write shape) are neither evidence nor breakers: they are
+ * skipped, so the detector errs towards silence.
+ */
+export type WriteEv = Extract<Ev, { k: "write" }>;
+export type FunctionChange = { fn: FunctionDef; constructor: boolean; deltas: Map<string, Lin>; writes: Map<string, WriteEv[]>; unknown: Map<string, string> };
+export type ConservationBreak = {
+  aggregate: string; ledger: string; breaker: FunctionChange; aggregateDelta: Lin; ledgerDelta: Lin;
+  maintainers: FunctionChange[]; neutral: string[]; skipped: Array<{ fn: string; why: string }>; absoluteLedgerWrite: boolean;
+};
+
+const UINT = /^u?int\d*$/;
+const ADDR_MAPPING = /^mapping\s*\(\s*address\s*=>\s*(.+)\)\s*$/;
+
+/** the quantity a write changes: `L` / `L.field` for an address-keyed ledger, `A` for a scalar integer; null for anything else */
+function quantity(ix: ProgramIndex, contract: string, w: WriteEv): { id: string; kind: "ledger" | "aggregate" | "other" } | null {
+  const sv = ix.stateVar(contract, w.variable); if (!sv || sv.constant || sv.immutable) return null;
+  const t = sv.type.replace(/\s+/g, " ").trim();
